# Скопируйте в .env и при необходимости поменяйте значения:
#   cp .env.example .env
# Рабочий .env в Git не попадает (см. .gitignore).
# Значения ниже — безопасные примеры для локального стенда, не секреты.

POSTGRES_DB=notes
POSTGRES_USER=notes_user
POSTGRES_PASSWORD=change_me_locally

# Порт, на котором входной Nginx слушает на хосте.
WEB_PORT=18080
