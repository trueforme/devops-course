# Версия «до оптимизации» — сохранена специально, чтобы было с чем сравнивать в dive.
# Это исходный Dockerfile первой пары: одна стадия, образ с uv внутри,
# рантайм тащит на себе весь инструментарий сборки.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

COPY pyproject.toml uv.lock ./

RUN uv sync --frozen --no-dev

COPY app.py .

CMD ["uv", "run", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
